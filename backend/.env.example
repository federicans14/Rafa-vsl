PORT=3002
NODE_ENV=development

# --- Base de datos -----------------------------------------------------------
#
# Base PROPIA de esta landing. Nunca compartirla con plan.entrenaconrafa.com:
# un SELECT * FROM leads devolvería los dos funnels revueltos.
#
# Para trabajar en local sin cuenta de Turso vale un fichero:
#   TURSO_DATABASE_URL=file:local-dev.db
#
TURSO_DATABASE_URL=libsql://xxxxx.turso.io
TURSO_AUTH_TOKEN=

# --- Auth del panel ----------------------------------------------------------
JWT_SECRET=

ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=Rafa

# --- CORS --------------------------------------------------------------------
# Lista separada por comas, sin barra final. En producción tiene que incluir
# el dominio definitivo Y la direccion .onrender.com del frontend.
CORS_ORIGIN=http://localhost:5174,http://localhost:4174

# --- Green API (WhatsApp) ----------------------------------------------------
#
# GREEN_API_CHAT_ID tiene que ser un grupo PROPIO de esta landing. Si se reutiliza
# el de plan.entrenaconrafa.com, los leads de los dos funnels caen en el mismo
# sitio y deja de saberse cual viene de donde.
#
GREEN_API_URL=https://api.green-api.com
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=
GREEN_API_CHAT_ID=
